+
+/// DepOS: read video details with ffprobe (resolution, length, codecs, HDR, audio,
+/// subtitles). Returns label/value pairs for the preview pane; None if ffprobe fails.
+/// DepOS: number of frames in the hover sequence (10 %, 20 %, … 90 %).
+pub const HOVER_FRAMES: usize = 9;
+
+/// DepOS: one frame of the hover sequence, cached under ~/.cache/thumbnails/depos-sequence.
+pub fn video_frame(path: &std::path::Path, n: usize) -> Option<std::path::PathBuf> {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    path.hash(&mut h);
+    std::fs::metadata(path).ok()?.modified().ok().hash(&mut h);
+    let dir = dirs::cache_dir()?.join("thumbnails/depos-sequence").join(format!("{:016x}", h.finish()));
+    let out = dir.join(format!("{n:02}.jpg"));
+    if out.exists() {
+        return Some(out);
+    }
+    std::fs::create_dir_all(&dir).ok()?;
+    let tmp = dir.join(format!("{n:02}.tmp.jpg"));
+    let ok = std::process::Command::new("ffmpegthumbnailer")
+        .arg("-i")
+        .arg(path)
+        .arg("-o")
+        .arg(&tmp)
+        .args(["-s", "512", "-q", "8", "-c", "jpeg", "-t"])
+        .arg(format!("{}%", 10 * (n + 1)))
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .ok()?
+        .success();
+    if !ok {
+        return None;
+    }
+    std::fs::rename(&tmp, &out).ok()?;
+    Some(out)
+}
+
+pub fn video_info(path: &std::path::Path) -> Option<Vec<(String, String)>> {
+    let output = std::process::Command::new("ffprobe")
+        .args([
+            "-v",
+            "error",
+            "-show_entries",
+            "format=duration,bit_rate:stream=codec_type,codec_name,profile,width,height,pix_fmt,color_transfer,r_frame_rate,channels,channel_layout:stream_tags=language",
+            "-of",
+            "compact=p=0",
+        ])
+        .arg(path)
+        .output()
+        .ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    let text = String::from_utf8_lossy(&output.stdout);
+    let mut info = Vec::new();
+    let (mut video, mut audio, mut subs) = (Vec::new(), Vec::new(), Vec::new());
+    let (mut duration, mut bit_rate) = (None, None);
+    for line in text.lines() {
+        let fields: std::collections::HashMap<&str, &str> =
+            line.split('|').filter_map(|kv| kv.split_once('=')).collect();
+        let get = |k: &str| fields.get(k).copied().filter(|v| !v.is_empty() && *v != "N/A" && *v != "unknown");
+        match get("codec_type") {
+            Some("video") if get("width").is_some() => video.push(fields.clone()),
+            Some("audio") => audio.push(fields.clone()),
+            Some("subtitle") => subs.push(get("tag:language").unwrap_or("?").to_string()),
+            _ => {
+                if let Some(d) = get("duration") {
+                    duration = d.parse::<f64>().ok();
+                }
+                if let Some(b) = get("bit_rate") {
+                    bit_rate = b.parse::<f64>().ok();
+                }
+            }
+        }
+    }
+    fn val<'a>(f: &std::collections::HashMap<&'a str, &'a str>, k: &str) -> Option<&'a str> {
+        f.get(k).copied().filter(|v| !v.is_empty() && *v != "N/A" && *v != "unknown")
+    }
+    if let Some(v) = video.first() {
+        if let (Some(w), Some(h)) = (val(v, "width"), val(v, "height")) {
+            info.push(("Çözünürlük".to_string(), format!("{w}×{h}")));
+        }
+        let mut codec = val(v, "codec_name").unwrap_or("?").to_uppercase();
+        if let Some(p) = val(v, "profile") {
+            codec.push_str(&format!(" {p}"));
+        }
+        if let Some(pf) = val(v, "pix_fmt") {
+            let depth = if pf.contains("10") { "10 bit" } else if pf.contains("12") { "12 bit" } else { "8 bit" };
+            codec.push_str(&format!(", {depth}"));
+        }
+        match val(v, "color_transfer") {
+            Some("smpte2084") => codec.push_str(", HDR10 (PQ)"),
+            Some("arib-std-b67") => codec.push_str(", HLG"),
+            _ => {}
+        }
+        if let Some((n, d)) = val(v, "r_frame_rate").and_then(|r| r.split_once('/')) {
+            if let (Ok(n), Ok(d)) = (n.parse::<f64>(), d.parse::<f64>()) {
+                if d > 0.0 {
+                    codec.push_str(&format!(", {:.3} fps", n / d));
+                }
+            }
+        }
+        info.push(("Video".to_string(), codec));
+    }
+    if let Some(d) = duration {
+        let s = d.round() as u64;
+        info.push(("Süre".to_string(), format!("{} sa {:02} dk {:02} sn", s / 3600, s / 60 % 60, s % 60)));
+    }
+    if let Some(b) = bit_rate {
+        info.push(("Bit hızı".to_string(), format!("{:.1} Mbit/s", b / 1_000_000.0)));
+    }
+    for a in &audio {
+        let mut s = val(a, "codec_name").unwrap_or("?").to_uppercase();
+        if let Some(l) = val(a, "channel_layout") {
+            s.push_str(&format!(" {l}"));
+        } else if let Some(c) = val(a, "channels") {
+            s.push_str(&format!(" {c} kanal"));
+        }
+        if let Some(lang) = val(a, "tag:language") {
+            s.push_str(&format!(" ({lang})"));
+        }
+        info.push(("Ses".to_string(), s));
+    }
+    if !subs.is_empty() {
+        info.push(("Altyazı".to_string(), subs.join(", ")));
+    }
+    (!info.is_empty()).then_some(info)
+}
