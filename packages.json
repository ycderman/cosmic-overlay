    },
    {
      "pn": "cosmic-icons",
      "repo": "cosmic-icons",
      "kind": "data",
      "desc": "Icon theme for the COSMIC desktop",
      "rdepend": [
        "x11-themes/pop-icon-theme"
      ]
    },
    {
      "pn": "cosmic-sound-theme",
      "repo": "cosmic-sound-theme",
      "kind": "meson",
      "desc": "Sound theme for the COSMIC desktop",
      "rdepend": []
    }
  ]
}
